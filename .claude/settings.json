{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(uvx ruff *)",
      "Bash(npx --yes prettier@3 *)",
      "Bash(colab sessions)",
      "Bash(colab status *)",
      "Bash(colab install *)",
      "Bash(colab exec *)",
      "Bash(colab upload *)",
      "Bash(colab download *)",
      "Bash(colab ls *)",
      "Bash(colab log *)",
      "Bash(colab stop *)",
      "Bash(colab restart-kernel *)",
      "Bash(colab help *)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": ["Bash(git push *)", "Bash(colab new *)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(colab repl*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r .tool_input.file_path); case \"$f\" in *.py) uvx ruff check --fix -q \"$f\" >&2 || exit 2; uvx ruff format -q \"$f\";; *.md|*.json|*.yaml|*.yml) npx --yes prettier@3 --write --log-level warn \"$f\";; esac"
          }
        ]
      }
    ]
  }
}
